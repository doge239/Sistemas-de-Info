# Copiar como backend/.env. NUNCA subir .env a GitHub.
# Supabase Dashboard > proyecto > Connect > Session pooler (puerto 5432)
# Pega la URL REAL de tu proyecto y reemplaza la clave.
# Agrega ?sslmode=require al final (o &sslmode=require si ya hay parametros).
PORT=4000
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CLAVE@HOST_REAL_DEL_POOLER:5432/postgres?sslmode=require
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_MAS_DE_32_CARACTERES
FRONTEND_ORIGIN=http://localhost:5173
